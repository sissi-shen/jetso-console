# Copy to .env.local to override defaults. Vite only exposes VITE_-prefixed vars.

# Mock backend is ON by default (demoable with zero credentials).
# Set to false to hit the real Module 2 backend once it exists.
VITE_USE_MOCK=true

# Base URL of the deployed backend (api/index.py on Vercel).
# Only used when VITE_USE_MOCK=false. Leave blank for same-origin.
VITE_API_BASE=
