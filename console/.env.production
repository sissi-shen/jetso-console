# Production build settings (committed — contains no secrets).
# Without this file VITE_USE_MOCK is undefined, and api.js treats undefined as
# "mock ON" — the deployed console would show fake demo data. Do not delete.
VITE_USE_MOCK=false

# Empty = same-origin relative calls (/api/...). Frontend and backend are served
# from one Vercel domain, so no absolute URL is needed or wanted.
VITE_API_BASE=
