# GA4 — Admin → Data Streams → [web stream] → Measurement Protocol API secrets
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=<your-ga4-measurement-protocol-secret>

# Supabase — Project Settings → API
# URL: the "Project URL" field (https://<project-id>.supabase.co)
SUPABASE_URL=https://<your-project-id>.supabase.co
# Key: use the "service_role" secret key (NOT the anon/public key)
SUPABASE_KEY=<your-supabase-service-role-key>

# CORS — comma-separated list of allowed frontend origins
# Set to your Vercel URL once deployed, e.g. https://jetso-tracker.vercel.app
# Leave as * during local development
FRONTEND_ORIGINS=*

# Invite-only login (Supabase Auth). false = no login required (local dev only).
# MUST be true in Vercel: it gates all 8 data endpoints behind a Supabase JWT.
# Accounts are created by hand in Supabase → Authentication → Users; public
# signups must be disabled there.
AUTH_REQUIRED=false

# ── Module 2: WordPress (single-tenant MVP; moves to tenant_wp_credentials later) ──
WP_BASE_URL=https://example.com
# WP login username of a dedicated Editor-role account (NOT the admin)
WP_USERNAME=jetso-editor
# WP Admin → Users → [account] → Application Passwords → add one named "jetso-console"
WP_APP_PASSWORD=<24-char application password from WP>
# UUID of the seeded row in the tenants table (see db/schema.sql)
TENANT_ID=00000000-0000-0000-0000-000000000001

# ── Module 2: LLM via OpenRouter (multi-model gateway; get key at openrouter.ai/keys) ──
# NOTE: placeholders here are deliberately NOT in the real key format —
# GitHub's push protection blocks pushes containing anything shaped like a
# live credential, even an obvious dummy.
OPENROUTER_API_KEY=<your-openrouter-key>          # starts with sk-or-v1-
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default = the cheap tier. Must be one of the three ids in MODEL_MENU
# (api/index.py); the backend rejects anything outside that menu.
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4-flash
# NOTE: the old direct DEEPSEEK_API_KEY / DEEPSEEK_MODEL vars are gone —
# every model now goes through OpenRouter.

# ── AI spend caps (USD per calendar month) ──
# Measured: one draft costs $0.0004 (default model) to $0.023 (Sonnet 5), so
# normal use is well under $1/month. These bound runaway loops and abuse.
# ALSO set a hard credit limit on the key at openrouter.ai → Keys → edit —
# that is the only ceiling a bug in our code cannot bypass.
# Keep USER < TENANT < the OpenRouter key's own credit limit, so our friendly
# in-app message always fires before OpenRouter returns a raw billing error.
AI_MONTHLY_CAP_USER=5
AI_MONTHLY_CAP_TENANT=8
# Refuse pages larger than this (one huge page = one huge bill)
AI_MAX_PAGE_CHARS=60000
